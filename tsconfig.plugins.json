{
  "compilerOptions": {
    "target": "ES5",
    "module": "ES2020",
    "moduleResolution": "node",
    "baseUrl": "./plugins",
    "paths": {
      "@modules/*": ["./modules/*"]
    },
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitUseStrict": true,
    "skipLibCheck": true
  },
  "include": [
    "plugins/**/*"
  ]
}
